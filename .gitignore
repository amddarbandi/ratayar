# ============================================
# Dependencies
# ============================================
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ============================================
# Build outputs
# ============================================
dist/
build/
.next/
out/
*.tsbuildinfo

# ============================================
# Environment (هرگز commit نشوند)
# ============================================
.env
.env.local
.env.*.local
.env.production
.env.development

# اما .env.example باید commit شود
!.env.example

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Runtime
# ============================================
pids/
*.pid
*.seed
*.pid.lock

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# IDE
# ============================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-*

# ============================================
# OS
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================
# Docker
# ============================================
docker/data/
docker/logs/

# ============================================
# Backups (فقط پوشه و فرمت‌های خاص)
# ============================================
backups/
*.bak
*.backup

# ⚠️ *.sql را ignore نکن چون migration‌های Prisma هم .sql هستند
# اما SQL dumpهای بکاپ را با نام‌گذاری خاص ignore کن:
*_dump.sql
backup_*.sql
db_*.sql

# ============================================
# Prisma (استثنا صریح برای migrations)
# ============================================
apps/api/prisma/migrations/dev.db
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
# اما migration.sql ها باید commit شوند:
!apps/api/prisma/migrations/**/*.sql

# ============================================
# PM2
# ============================================
.pm2/
*.pm2.log

# ============================================
# Turbo
# ============================================
.turbo/

# ============================================
# Secrets (هرگز)
# ============================================
.secrets/
*.pem
*.key
!**/public/**/*.pem

# ============================================
# Miscellaneous
# ============================================
*.tmp
*.temp
.cache/

# Gitignore backups (خودمان)
.gitignore.backup-*
*.gitignore.bak
