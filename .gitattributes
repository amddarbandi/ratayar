# تنظیم خط پایانی پیش‌فرض
* text=auto eol=lf

# فایل‌های باینری
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary

# فایل‌های lock (نباید diff شوند)
pnpm-lock.yaml -diff
package-lock.json -diff
yarn.lock -diff

# فایل‌های تولیدشده (linguist)
dist/** linguist-generated=true
.next/** linguist-generated=true
