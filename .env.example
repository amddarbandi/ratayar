# ============================================
# Ratayar Platform — Environment Variables
# ============================================
# این فایل template است. مقادیر واقعی را در .env (که در .gitignore است) قرار دهید.
# هرگز این فایل را با مقادیر واقعی commit نکنید.
# ============================================

# Environment
NODE_ENV=development
TZ=Asia/Tehran

# Domain
DOMAIN=ratayar.ir
PROTOCOL=https

# ============================================
# PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zarvan
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zarvan_db
POSTGRES_MAX_CONNECTIONS=200

# Database URL for Prisma
DATABASE_URL=postgresql://zarvan:CHANGE_ME_STRONG_PASSWORD@localhost:5432/zarvan_db?schema=public

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================
# MinIO
# ============================================
MINIO_ROOT_USER=zarvan_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Endpoint (internal)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# MinIO Public (for presigned URLs)
MINIO_PUBLIC_ENDPOINT=ratayar.ir
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# ============================================
# JWT
# ============================================
# حداقل ۳۲ کاراکتر تصادفی. با `openssl rand -base64 48` بساز.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# API
# ============================================
API_PORT=4000
API_URL=https://ratayar.ir/api
WEB_URL=https://ratayar.ir

# ============================================
# Cookie
# ============================================
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_MIN_32_CHARS

# ============================================
# SMS (Kavenegar)
# ============================================
DEV_OTP_ENABLED=false
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ============================================
# External Services (اختیاری)
# ============================================
PAYMENT_API_KEY=
OPENAI_API_KEY=
